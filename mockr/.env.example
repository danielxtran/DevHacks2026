# Use the shared repository-root .env; both Vite apps load the same hosted project.
# See ../.env.example.

# The API server (server/) reads these. They are the same public URL and anon/publishable key
# as VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY; if these are unset, the server falls back to the
# VITE_ names. Never put the service role / secret key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# The /2/* developer API is public: no tokens needed.

# Optional
# PORT=4175          # API port (and the single port in production via `npm start`)
# TRUST_PROXY=1      # set when deployed behind a proxy, so per-IP rate limiting sees real client IPs
