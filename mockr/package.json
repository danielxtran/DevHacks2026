{
  "name": "mockr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json && vite build",
    "start": "tsx server/index.ts --prod",
    "test": "vitest run",
    "preview": "vite preview --port 5175"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "cors": "2.8.5",
    "express": "4.21.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.27.0",
    "tsx": "4.19.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.9.0",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@types/supertest": "6.0.2",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.0",
    "postcss": "8.4.47",
    "supertest": "7.0.0",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
