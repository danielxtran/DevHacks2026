# Copy to .env.local (gitignored) and fill in the Supabase keys.

# Client-side (safe to ship in the browser bundle): publishable / anon key.
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Server-side ONLY (bypasses Row Level Security). Used by the one-time data
# push script (supabase/push-seed.mjs). NEVER commit a real value or ship it
# in client code.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
