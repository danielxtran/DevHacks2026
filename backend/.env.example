# Optional backend-only settings. The backend also loads the repository-root .env.
# Get this connection string from the hosted Supabase project's Connect panel.
SUPABASE_DB_URL=
# Public source APIs; neither source requires a key or bearer token.
RIOTDIT_BASE_URL=http://127.0.0.1:5174
R_BASE_URL=http://127.0.0.1:5175
# Local Hexlab API used by backend-owned numeric experiments.
HEXLAB_API_URL=http://127.0.0.1:3002/api
# Caps Riotdit root posts and R tweets; Riotdit inline comments are not item-capped.
COLLECTOR_MAX_ITEMS=2000
OPENAI_API_KEY=
# A model available to your OpenAI project that supports Responses function calling.
OPENAI_MODEL=
# Set after the runner/scenario inputs are available.
BASELINE_REVISION=
SCENARIO_MANIFEST=[]
