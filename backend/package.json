{
  "name": "devhacks-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../.env --env-file-if-exists=.env dist/server.js",
    "test": "npm run build && node --test dist/*.test.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "openai": "7.57.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.12.0",
    "@types/pg": "8.11.10",
    "tsx": "4.23.15",
    "typescript": "5.6.3"
  }
}
